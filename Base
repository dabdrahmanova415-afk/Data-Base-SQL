CREATE TABLE f1_telemetry (
    telemetry_id INT PRIMARY KEY AUTO_INCREMENT,
    
    driver_name VARCHAR(50),
    team_name VARCHAR(50),
    
    lap_number INT,
    sector INT,
    
    speed_kmh FLOAT,
    engine_rpm INT,
    throttle_percent FLOAT,
    brake_percent FLOAT,
    
    tire_temp_front_left FLOAT,
    tire_temp_front_right FLOAT,
    tire_temp_rear_left FLOAT,
    tire_temp_rear_right FLOAT,
    
    fuel_level FLOAT,
    drs_enabled BOOLEAN,
    
    gps_x FLOAT,
    gps_y FLOAT,
    
    timestamp_ms BIGINT
);


