3. Анализ максимальной скорости
SELECT 
    driver_name,
    MAX(speed_kmh) AS max_speed
FROM f1_telemetry
GROUP BY driver_name
ORDER BY max_speed DESC;

4. Анализ перегрева шин
SELECT
    lap_number,
    
    AVG(
        (
            tire_temp_front_left +
            tire_temp_front_right +
            tire_temp_rear_left +
            tire_temp_rear_right
        ) / 4
    ) AS avg_tire_temp

FROM f1_telemetry
GROUP BY lap_number
ORDER BY avg_tire_temp DESC;

5. Где пилот тормозит сильнее всего
SELECT
    sector,
    AVG(brake_percent) AS avg_braking
FROM f1_telemetry
GROUP BY sector
ORDER BY avg_braking DESC;

6. Поиск эффективности DRS
SELECT
    drs_enabled,
    AVG(speed_kmh) AS avg_speed
FROM f1_telemetry
GROUP BY drs_enabled;

